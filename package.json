{
  "name": "dsh-workbuddy",
  "version": "0.5.0",
  "private": false,
  "description": "把 WorkBuddy 账号接入 DeepSeek Harness：所有账号共用一家 provider（账号池轮转），全部模型进选择器、按账号显示积分余额、自动绕过 11128 渠道校验，并与 dsh-purge 融合压上破甲层。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "codebuddy",
    "provider",
    "llm",
    "jailbreak"
  ],
  "license": "MIT",
  "author": "LIUFelix2004",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LIUFelix2004/dsh-workbuddy.git"
  },
  "homepage": "https://github.com/LIUFelix2004/dsh-workbuddy#readme",
  "bugs": {
    "url": "https://github.com/LIUFelix2004/dsh-workbuddy/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node --test test/pool-abort.test.mjs test/pool-reliability.test.mjs test/provider-routes.test.mjs test/pool-startup.test.mjs test/account-store.test.mjs test/guard.test.mjs test/catalog-and-url.test.mjs"
  }
}
